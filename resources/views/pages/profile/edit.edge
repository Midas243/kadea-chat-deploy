@layouts.chat({ title: 'Mon profil', conversations, activeId, q: '', results: [], view: 'chat' })
  <header class="chat__head">
    <a href="{{ urlFor('conversations.index') }}" class="chat__back iconbtn" aria-label="Retour aux conversations">
      @svg('lucide:arrow-left', { width: 18, height: 18 })
    </a>
    <div>
      <div class="chat__title">Mon profil</div>
      <div class="chat__subtitle">{{ auth.user.email }}</div>
    </div>
  </header>

  <div class="panel">
    <h2 class="panel__title">Informations personnelles</h2>
    @form({
      route: 'profile.update',
      method: 'POST',
      class: 'panel__form',
      enctype: 'multipart/form-data',
      'x-data': '{ submitting: false }',
      'x-on:submit': 'submitting = true',
    })
      <div class="profile__identity">
        @!avatar({ initials: auth.user.initials, src: auth.user.profilePicture, class: 'avatar avatar--xl', alt: 'Photo de profil' })
        <p class="field__hint">JPG, PNG ou WebP, 2 Mo maximum.</p>
      </div>
      @field.root({ name: 'profilePicture' })
        @!field.label({ text: 'Photo de profil' })
        @!input.control({ type: 'file', accept: 'image/jpeg,image/png,image/webp' })
        @!field.error()
      @end
      @field.root({ name: 'fullName' })
        @!field.label({ text: 'Nom complet' })
        @!input.control({ autocomplete: 'name', value: auth.user.fullName })
        @!field.error()
      @end
      @!button({
        text: 'Enregistrer',
        type: 'submit',
        'x-bind:disabled': 'submitting',
        'x-text': "submitting ? 'Enregistrement…' : 'Enregistrer'",
      })
    @end

    <h2 class="panel__title">Mot de passe</h2>
    @form({
      route: 'profile.password',
      method: 'POST',
      class: 'panel__form',
      'x-data': '{ submitting: false }',
      'x-on:submit': 'submitting = true',
    })
      @field.root({ name: 'currentPassword' })
        @!field.label({ text: 'Mot de passe actuel' })
        @!input.control({ type: 'password', autocomplete: 'current-password' })
        @!field.error()
      @end
      @field.root({ name: 'password' })
        @!field.label({ text: 'Nouveau mot de passe' })
        @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '8 caractères minimum' })
        @!field.error()
      @end
      @field.root({ name: 'passwordConfirmation' })
        @!field.label({ text: 'Confirmer le nouveau mot de passe' })
        @!input.control({ type: 'password', autocomplete: 'new-password' })
        @!field.error()
      @end
      @!button({
        text: 'Changer le mot de passe',
        type: 'submit',
        'x-bind:disabled': 'submitting',
        'x-text': "submitting ? 'Modification…' : 'Changer le mot de passe'",
      })
    @end
  </div>
@end
