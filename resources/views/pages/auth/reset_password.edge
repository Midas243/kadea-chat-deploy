@layouts.auth()
  <h1 class="auth__title">Nouveau mot de passe</h1>
  <p class="auth__sub">Choisissez un mot de passe d'au moins 8 caractères.</p>
  @form({
    route: 'password.update',
    routeParams: { token: token },
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
      @!field.error()
    @end
    @!button({
      text: 'Enregistrer',
      type: 'submit',
      block: true,
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Enregistrement…' : 'Enregistrer'",
    })
  @end
@end
