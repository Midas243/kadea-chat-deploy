@layouts.auth()
  <h1 class="auth__title">Mot de passe oublié ?</h1>
  <p class="auth__sub">Saisissez votre adresse : nous vous enverrons un lien pour en choisir un nouveau.</p>
  @form({
    route: 'password.send',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({ type: 'email', autocomplete: 'email', placeholder: 'vous@exemple.com' })
      @!field.error()
    @end
    @!button({
      text: 'Envoyer le lien',
      type: 'submit',
      block: true,
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Envoi…' : 'Envoyer le lien'",
    })
  @end

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Retour à la connexion
    @end
  </p>
@end
