@form({
  route: 'messages.store',
  routeParams: { conversationId: $props.get('conversationId') },
  class: 'composer',
  'x-on:submit': 'send($event)',
})
  <textarea
    name="content"
    class="composer__input"
    rows="1"
    maxlength="2000"
    placeholder="Écrivez un message…"
    required
    autofocus
    x-on:keydown.enter="if (!$event.shiftKey) { $event.preventDefault(); $el.form.requestSubmit() }"
  ></textarea>
  <button type="submit" class="btn btn--primary composer__send" x-bind:disabled="sending" aria-label="Envoyer">
    <span x-show="!sending && !sent">@svg('lucide:send', { width: 16, height: 16 })</span>
    <span x-show="sent" x-cloak>@svg('lucide:check', { width: 16, height: 16 })</span>
    <span x-show="sending" x-cloak>…</span>
  </button>
@end
