@let(size = $props.get('size', 32))
@let(showWord = $props.get('word', true))
@link({
  route: 'home',
  'aria-label': 'Kadea Chat',
  style: 'display: inline-flex; align-items: center; gap: 10px; color: var(--ink);',
})
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill="var(--brand)" />
    <path d="M9 11a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v4.5a4 4 0 0 1-4 4h-4.2L11 23v-3.5a4 4 0 0 1-2-3.5z" fill="#fff" />
    <circle cx="24" cy="8" r="3.2" fill="var(--accent)" stroke="var(--brand)" stroke-width="1.5" />
  </svg>
  @if(showWord)
    <span class="logo__word" style="font-size: {{ size * 0.6 }}px; font-weight: 700;">Kadea Chat</span>
  @end
@end
