# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# En ligne : l'adresse publique du site (https://...), jamais localhost
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=kadeachat

# E-mail (Brevo) : l'adresse expéditeur doit être validée dans Brevo
MAIL_MAILER=brevo
MAIL_FROM_NAME=Kadea Chat
MAIL_FROM_ADDRESS=
BREVO_API_KEY=
